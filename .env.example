# Copy to .env.local for local development, and add the same names in
# Vercel -> Project -> Settings -> Environment Variables for the live site.

# --- Supabase: saves every enquiry to the `enquiries` table -------------------
# Supabase dashboard -> Project Settings -> API.
# The service-role key is SECRET: never commit it or expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notification -------------------------------------------------------
# By default enquiries are emailed via FormSubmit (https://formsubmit.co) to the
# first address in src/lib/site.ts. The very first enquiry sends an activation
# email to that inbox; click the link once and all later enquiries are delivered.

# Optional: send enquiries to a different inbox.
ENQUIRY_TO_EMAIL=

# Optional: use Resend (https://resend.com) instead of FormSubmit.
# FROM must be an address on a domain verified in Resend, e.g. "Website <enquiries@bacollang.com>"
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
